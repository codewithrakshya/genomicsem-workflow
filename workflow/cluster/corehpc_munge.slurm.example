#!/usr/bin/env bash
#SBATCH --job-name=genomicsem_munge
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=.work/logs/genomicsem_munge-%j.log

set -euo pipefail

# Replace this with the R module required by coreHPC.
# module load R

export GENOMICSEM_CORES="${SLURM_CPUS_PER_TASK:-1}"
workflow/bin/run-r workflow/scripts/01_munge.R \
  config/traits.tsv \
  reference/w_hm3.snplist
